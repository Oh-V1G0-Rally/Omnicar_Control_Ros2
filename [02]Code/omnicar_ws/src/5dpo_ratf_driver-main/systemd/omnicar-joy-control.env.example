# Copy to /etc/omnicar/omnicar-joy-control.env and adjust if needed.

ROS_DISTRO=jazzy
OMNICAR_WS=/home/c2sr/Omnicar_Control_Ros2/[02]Code/omnicar_ws

ROBOT_ID=omnicar
DRIVER_PORT=/dev/omnicar_esp32
JOY_DEV=/dev/input/js0
LIDAR_PORT=/dev/omnicar_lidar

# Keep the boot profile minimal and reliable for joystick control.
USE_DRIVER=true
USE_JOY=true
USE_ODOM=true
USE_CMD_VEL_BRIDGE=true
USE_LIDAR=false
USE_LOCALIZATION=false
USE_WAYPOINT_CONTROLLER=false
